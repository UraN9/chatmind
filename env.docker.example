# Docker-specific environment config.
#
# Copy this to .env.docker and fill in real values (POSTGRES_PASSWORD,
# TELEGRAM_BOT_TOKEN). .env.docker itself is gitignored, same as .env.
#
# Why a separate file from .env: .env is meant for running the bot
# directly on the host (e.g. Windows), where things like
# TESSERACT_CMD or HF_HOME may point at Windows paths. Those paths
# don't exist inside the Linux container, so this file uses
# container-appropriate values instead.

# Database -- POSTGRES_HOST is the compose service name, not
# localhost, since the bot reaches Postgres over the compose network.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=chatmind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_TEST_DB=chatmind_test

# Telegram bot
TELEGRAM_BOT_TOKEN=

# OCR: leave empty so pytesseract finds the apt-get-installed
# tesseract binary via PATH inside the container.
TESSERACT_CMD=

# Hugging Face / open_clip model cache -- matches the hf_cache volume
# mount in docker-compose.yml so CLIP weights persist across restarts.
HF_HOME=/root/.cache/huggingface
